<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PackageId>FeatureTestFramework.HttpSteps</PackageId>
	<Version>1.0.1</Version>
	<Product>CommonHttpSteps</Product>
	<IsPackable>True</IsPackable>
	<Authors>Tomas Vainoris</Authors>
	<Description>A feature test framework for testing features.</Description>
	<PackageTags>feature test framework testing</PackageTags>
	<PackageReleaseNotes>Method name fixes.</PackageReleaseNotes>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.2" />
    <PackageReference Include="AutoFixture" Version="5.0.0-preview0012" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
	<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.2" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
	<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.2" />
	<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
	<PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
	<PackageReference Include="Reqnroll" Version="3.3.2" />
	<PackageReference Include="Reqnroll.xUnit" Version="3.3.2" />
	<PackageReference Include="WireMock.Net" Version="1.23.0" />
	<PackageReference Include="WireMock.Net.FluentAssertions" Version="1.23.0" />
	  
  </ItemGroup>

</Project>
